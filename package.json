{
  "name": "@zdp/architecture-linter",
  "version": "0.44.4",
  "private": true,
  "type": "module",
  "bin": {
    "zdp-arch": "./src/cli.ts"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "check:tsgo": "tsgo --noEmit",
    "profile:validation": "bun scripts/profile-validation-performance.ts",
    "test": "bun test",
    "validate:architecture": "bun src/cli.ts validate --architecture ../../docs/zdp-architecture",
    "validate:self": "bun src/cli.ts validate --architecture ../../docs/zdp-architecture --repository .",
    "validate:self-contained": "bun src/cli.ts validate --architecture fixtures/self-architecture --repository ."
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "oxc-parser": "^0.153.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "typescript": "^7.0.2"
  }
}
